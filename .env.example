# ============================================
# JazzCash AI Assistant — Environment Config
# ============================================
# Copy to backend/.env
# NEVER expose keys to the frontend.

# --- Jazz Gemma chat LLM (OpenAI-compatible / vLLM) ---
LLM_API_KEY=not-required
LLM_MODEL=gemma-3-12b-dpo-apr-merged-aws
LLM_BASE_URL=https://gemma-3-12b-dpo-apr-merged-aws-teknosys-ai.apps.aiops.jazz.com.pk/v1
# Internal Jazz AIOps TLS often uses a private CA
LLM_VERIFY_SSL=false
LLM_JSON_MODE=false
LLM_MAX_TOKENS=1024

# --- Optional OpenAI for embeddings / Whisper / TTS ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_ENABLED=false

# --- Speech-to-Text ---
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=whisper-1

# --- Text-to-Speech ---
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=nova

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
DEEPGRAM_API_KEY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_MODE_DEFAULT=false
PORT=8000
