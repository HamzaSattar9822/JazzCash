# ============================================
# JazzCash AI Assistant — Environment Config
# ============================================
# Copy to backend/.env and fill in your keys.
# NEVER expose these keys to the frontend.

# --- LLM Provider (OpenAI-compatible) ---
LLM_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- Embeddings (for RAG) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Speech-to-Text ---
# Options: openai | deepgram
STT_PROVIDER=openai
STT_API_KEY=
# If empty, falls back to LLM_API_KEY
STT_MODEL=whisper-1

# --- Text-to-Speech ---
# Options: openai | elevenlabs
TTS_PROVIDER=openai
TTS_API_KEY=
# If empty, falls back to LLM_API_KEY
TTS_MODEL=tts-1
TTS_VOICE=nova

# --- ElevenLabs (optional, if TTS_PROVIDER=elevenlabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Deepgram (optional, if STT_PROVIDER=deepgram) ---
DEEPGRAM_API_KEY=

# --- App ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEV_MODE_DEFAULT=false
PORT=8000
